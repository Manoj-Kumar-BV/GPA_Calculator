# Environment Variables for Student LMS GPA Calculator
# Copy this to .env.local for local development
# For production deployment, add these to your hosting platform

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB Connection String (Required)
# Get this from MongoDB Atlas (free tier available)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=your_mongodb_connection_string_here

# ==========================================
# AUTHENTICATION CONFIGURATION
# ==========================================
# NextAuth.js Secret (Required)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Site URL (Required)
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# OAUTH PROVIDERS (Optional)
# ==========================================
# Google OAuth (Optional but recommended)
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth (Optional)
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ==========================================
# NOTES
# ==========================================
# 1. Never commit .env.local to version control
# 2. For production, use your hosting platform's environment variables
# 3. MongoDB Atlas free tier (M0) is sufficient for this application
# 4. OAuth providers are optional - email/password authentication works without them
